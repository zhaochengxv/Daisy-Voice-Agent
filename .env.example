# 火山引擎语音识别（豆包 ASR）
VOLCENGINE_APP_ID=your_app_id
VOLCENGINE_ACCESS_TOKEN=your_access_token
VOLCENGINE_RESOURCE_ID=volc.seedasr.sauc.duration
VOLCENGINE_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# DeepSeek LLM
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Edge TTS 音色（可选）
# EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# 视觉理解模型（可选，analyze_image/analyze_video 工具需要）
# 首选：智谱 GLM-4.6V-Flash（官方完全免费，bigmodel.cn 注册即可用），视觉推理 + 128K 上下文
# VISUAL_API_KEY=your_zhipu_api_key
# VISUAL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VISUAL_MODEL=glm-4.6v-flash
#
# 备用视觉模型（可选，强烈推荐）：智谱免费模型高峰期会限流（返回"拥挤/繁忙"，错误码 1302/1305），
# Daisy 会自动重试并降级到备用供应商。推荐硅基流动（cloud.siliconflow.cn，注册送额度，无需实名）：
# VISUAL_BACKUP_API_KEY=your_siliconflow_api_key
# VISUAL_BACKUP_BASE_URL=https://api.siliconflow.cn/v1
# VISUAL_BACKUP_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
#
# 若改用豆包视觉（需火山方舟 API Key；旧版 doubao-seed-1-6-vision 已下线）：
# VISUAL_API_KEY=your_ark_api_key
# VISUAL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VISUAL_MODEL=doubao-seed-2-1-turbo-260628

# 全局快捷键（可选）
# 默认 RightOption（按住键盘右侧 Option 键说话，松手发送）
# GLOBAL_SHORTCUT=RightOption